        </div>
                
        <div class="gimmick-info-wide"><a href="#" id="gimmick-btn">Play with<img src="/images/tubu/icon_playwith.webp" class="gimmick-icon"></a></div>
      </div>

  </div>

  </div>
  </main>


  

<nav class="side-bar" id="side-bar">
